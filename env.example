# Copy this file to .env.local and fill in your values

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=read_more_about

# Public site URL (used for article + image links in emails)
NEXT_PUBLIC_SITE_URL=https://www.read-more-about.com

# SMTP (Gmail example: smtp.gmail.com / 587 / your gmail / app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
MAIL_FROM=you@example.com

# Daily newsletter schedule (cron syntax) + timezone. Default: every day 08:00
NEWSLETTER_CRON=0 8 * * *
NEWSLETTER_TZ=America/New_York
# true = resend the same article even if the subscriber already got it
NEWSLETTER_ALLOW_REPEAT=false

# Secret for POST /api/newsletter/send/ (manual or external cron trigger)
CRON_SECRET=change-me-to-a-long-random-string
